-- НАСТРОЙКИ
local autoFarmEnabled = false
local killNPCs = true
local killPlayers = true

-- КЛИК
local function click()
    if mouse1click then pcall(mouse1click) end
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new(
            workspace.CurrentCamera.ViewportSize.X / 2,
            workspace.CurrentCamera.ViewportSize.Y / 2
        ))
    end)
end

local function spamClick(count, delay)
    count = count or 8
    delay = delay or 0.15
    for i = 1, count do
        click()
        task.wait(delay)
    end
end

-- ПОИСК И ЛОГИКА
local function getMyDrone() return workspace:FindFirstChild(LocalPlayer.Name .. "_FPVDrone") end

local function getClosestPlayer()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    local closest, closestDist = nil, math.huge
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Head")
                if part then
                    local dist = (part.Position - myPos).Magnitude
                    if dist < closestDist then closestDist = dist closest = plr.Character end
                end
            end
        end
    end
    return closest
end

local function getClosestNPC()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    local closest, closestDist = nil, math.huge
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:find("EnemyNPC") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                if part then
                    local dist = (part.Position - myPos).Magnitude
                    if dist < closestDist then closestDist = dist closest = obj end
                end
            end
        end
    end
    return closest
end

local function getClosestTarget()
    if killPlayers then
        local p = getClosestPlayer()
        if p then return p end
    end
    if killNPCs then
        local n = getClosestNPC()
        if n then return n end
    end
    return nil
end

RunService.Heartbeat:Connect(function()
    if not autoFarmEnabled then return end
    local drone = getMyDrone()
    if not drone then return end
    local target = getClosestTarget()
    if not target then return end
    local hrp = target:FindFirstChild("HumanoidRootPart")
    if not hrp then hrp = target:FindFirstChild("Head") or target:FindFirstChildWhichIsA("BasePart") end
    if not hrp then return end
    local feetPos = hrp.Position - Vector3.new(0, 2, 0)
    pcall(function() drone:PivotTo(CFrame.new(feetPos)) end)
end)

local function clickToBattle()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    for _, gui in pairs(playerGui:GetDescendants()) do
        if gui:IsA("TextButton") or gui:IsA("ImageButton") then
            local text = (gui.Text or ""):lower()
            if text:find("battle") or text:find("в бой") or text:find("играть") then
                pcall(function() gui:Activate() end)
                return true
            end
        end
    end
    return false
end

task.spawn(function()
    while task.wait(5) do
        if autoFarmEnabled then
            local char = LocalPlayer.Character
            if not char or (char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health <= 0) then
                clickToBattle()
            else
                char.HumanoidRootPart.CFrame = CFrame.new(BOX_POS)
                task.wait(0.5)
                workspace.CurrentCamera.CFrame = CFrame.new(BOX_POS + Vector3.new(0, 10, 0), BOX_POS)
                task.wait(0.5)
                spamClick(8, 0.15)
            end
        end
    end
end)

